# hunter ortam değişkenleri — .env olarak kopyalayıp doldurun (.env git'e girmez).

# ZORUNLU (canlı modda): fine-grained PAT
#   Repo: yalnız omerdduran/turk-adfilter
#   İzin: Contents = Read and write, Pull requests = Read and write
# Token YOKSA bot otomatik dry-run'a düşer (PR açmaz).
GITHUB_TOKEN=

# --- İlk kalibrasyon (ÖNERİLEN başlangıç) ---
# İlk 1-2 hafta: PR açma, sadece aday topla + logla. Eşiği/allowlist'i ayarla.
HUNTER_DRY_RUN=true

# --- Opsiyonel override'lar (varsayılanlar parantezde) ---
# HUNTER_INTERVAL=24h
# HUNTER_SOURCES=mirror,crtsh,crawl,phishing   # phishing = banka/kurum sahte domainleri
# HUNTER_CONFIDENCE_MIN=70
# HUNTER_MAX_PER_PR=30
# HUNTER_DNS_SERVERS=1.1.1.1:53,1.0.0.1:53,8.8.8.8:53  # filtresiz; "system" = OS resolver
# HUNTER_MIRROR_CAP=6000
# HUNTER_MIRROR_MAX_STEP=20   # her bahis domainindeki sayıyı +1..+N artır (daha çok varyant)
# HUNTER_CRTSH_PER_RUN=5
# HUNTER_ALLOWLIST_EXTRA=a.com,b.net          # ek sert-ret domainler (CSV)
# LOG_LEVEL=info
# LOG_FORMAT=json
